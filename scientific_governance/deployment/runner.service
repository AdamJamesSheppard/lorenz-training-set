[Unit]
Description=Isolated Lorenz scientific execution (owner must provision identities)
ConditionPathExists=/etc/lorenz-science/allowed_signers

[Service]
Type=oneshot
User=lorenz-executor
Group=lorenz-executor
ExecStart=/opt/lorenz-executor/venv/bin/python -I -m scientific_governance.runner --spec /var/lib/lorenz-executor/submissions/approved/spec.json --signers /etc/lorenz-science/allowed_signers --checkout /opt/lorenz-executor/source --output /var/lib/lorenz-executor/submissions/result
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ReadOnlyPaths=/opt/lorenz-executor /etc/lorenz-science
ReadWritePaths=/var/lib/lorenz-executor/submissions
InaccessiblePaths=/var/lib/lorenz-evaluation /var/lib/lorenz-owner

# Deployment template only; installed package/venv/account/ACLs not provisioned.
# Do not install or claim trusted execution until a separate administrator reviews it.
