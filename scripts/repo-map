#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
mkdir -p docs/generated

map_file="docs/generated/REPO_MAP.md"
{
  echo '# Repository map'
  echo
  echo "Generated: $(date -Is)"
  echo
  echo '```text'
  find lorenz_fpe tests scripts docs experiments -maxdepth 3 -type f \
    ! -path '*/__pycache__/*' | sort
  find . -maxdepth 1 -type f \( -name '*.py' -o -name '*.md' -o -name '*.json' \) | sort
  echo '```'
  echo
  echo '## Python symbols'
  rg -n '^\s*(class|def)\s+[A-Za-z_][A-Za-z0-9_]*' lorenz_fpe tests scripts ./*.py || true
} > "$map_file"

echo "wrote $map_file"

