#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo '=== PROJECT STATE ==='
sed -n '1,100p' docs/PROJECT_STATE.md

echo
echo '=== GIT ==='
git status --porcelain=v2 --branch

echo
echo '=== RECENT COMMITS ==='
git log --oneline -5

echo
echo '=== ENVIRONMENT ==='
./scripts/run-in-env python - <<'PY'
import platform
import sys
import dolfinx
import numpy
import scipy
print('python:', sys.version.split()[0])
print('platform:', platform.platform())
print('dolfinx:', dolfinx.__version__)
print('numpy:', numpy.__version__)
print('scipy:', scipy.__version__)
PY

echo
echo '=== QUICK TEST ==='
quick_log="$(mktemp)"
trap 'rm -f "$quick_log"' EXIT
if ./scripts/run-in-env python -m pytest -q tests/test_limiter.py >"$quick_log" 2>&1; then
  tail -n 2 "$quick_log"
else
  echo 'quick test: FAIL'
  tail -n 12 "$quick_log"
fi

echo
echo '=== LATEST MATH SUMMARY ==='
if [ -f results/math_checks.json ]; then
  jq '{passed, method_certified, classification, checks}' results/math_checks.json
else
  echo 'none; run ./scripts/verify-math'
fi

