#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# Upgrade only the isolated training runtime; do not alter PDE/MFEM packages.
test -x .venv/neural-pilot/bin/python
.venv/neural-pilot/bin/python -m pip install numpy==2.2.6
.venv/neural-pilot/bin/python -m pip install --upgrade \
  torch==2.8.0+cu128 --index-url https://download.pytorch.org/whl/cu128
.venv/neural-pilot/bin/python -c \
  'import torch; assert torch.cuda.is_available(); print(torch.__version__, torch.cuda.get_device_name(0))'
